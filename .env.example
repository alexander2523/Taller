# Copia este archivo como .env y reemplaza todos los valores de ejemplo.
DB_USER=taller_app
DB_PASSWORD=CAMBIAR_POR_UN_SECRETO_LARGO
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_OTRO_SECRETO_LARGO
BOOTSTRAP_ADMIN_EMAIL=admin@tudominio.com
BOOTSTRAP_ADMIN_PASSWORD=CambiarEstaClave2026
# Origen exacto del navegador (sin ruta final), por ejemplo https://taller.ejemplo.com
APP_CORS_ALLOWED_ORIGINS=https://taller.ejemplo.com
APP_FRONTEND_URL=https://taller.ejemplo.com
# SMTP para enviar enlaces de recuperación de contraseña
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USERNAME=usuario-smtp
SMTP_PASSWORD=CAMBIAR_POR_UN_SECRETO
MAIL_FROM=no-reply@tudominio.com
# Solo para una demo escolar: muestra el token en la pantalla; mantener en false en producción.
APP_PASSWORD_RESET_SHOW_TOKEN=false
HTTP_PORT=8080
